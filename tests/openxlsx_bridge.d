import z8.xlsx.openxlsx : Workbook, CellType;
import std.exception : assertThrown;
import std.file : read, write;
import std.algorithm.searching : canFind;

void main(string[] args) {
    assertThrown!Exception(new Workbook(args[1] ~ ".missing"));
    auto book = new Workbook(args[1]);
    assert(book.sheetCount() == 3);
    assert(book.sheetName(0) == "Данные 😀");
    assert(book.sheetName(1) == "Second");
    assert(book.workbookXml().canFind("Данные 😀"));
    assert(book.sharedStringsXml().canFind("sst"));
    assert(book.sheetXml(0).canFind("_x0041_"));
    assert(book.rowCount(0) == 2 && book.rowCount(1) == 2);
    assert(book.rowCount(2) == 0 && !book.rowExists(2, 0));
    assert(!book.rowExists(1, 0) && book.rowExists(1, 1));
    assert(!book.rowExists(1, 2) && book.rowExists(1, 3));
    assert(book.cellCount(0, 0) == 10 && book.cellCount(0, 1) == 1);
    assert(book.cellCount(1, 1) == 1 && book.cellCount(1, 3) == 0);
    assertThrown!Exception(book.cellCount(1, 0));
    assertThrown!Exception(book.rowExists(0, 1048576));
    assert(book.rowCount(1) == 2);
    assert(book.cellString(0, 0, 0) == "Привет 😀 & text");
    assert(book.cellString(0, 0, 1) == "42");
    assert(book.cellType(0, 0, 0) == CellType.text);
    assert(book.cellType(0, 0, 1) == CellType.integer);
    assert(book.cellType(0, 0, 2) == CellType.missing);
    assert(book.cellType(0, 0, 3) == CellType.blank);
    assert(book.cellType(0, 0, 4) == CellType.boolean);
    assert(book.cellType(0, 0, 5) == CellType.floating);
    assert(book.cellNumber(0, 0, 1) == 42);
    assert(book.cellNumber(0, 0, 5) == 42.25);
    assert(book.cellNumber(0, 0, 6) == 84);
    assert(book.cellFormula(0, 0, 6) == "B1*2");
    assert(book.cellHasFormula(0, 0, 6));
    assert(!book.cellHasFormula(0, 0, 1));
    assert(book.cellHasFormula(0, 1, 7));
    assert(book.cellXml(0, 1, 7).canFind("t=\"shared\""));
    assert(book.cellXml(0, 0, 9).canFind("_x0041_"));
    assert(book.cellXml(0, 0, 9).canFind("First"));
    assert(book.cellFormula(0, 0, 1) == "");
    assert(book.cellNumber(0, 0, 7) == 43);
    assert(book.cellNumber(0, 1, 7) == 45);
    assert(book.cellNumber(0, 0, 8) == 44);
    assertThrown!Exception(book.cellFormula(0, 0, 7));
    assertThrown!Exception(book.cellFormula(0, 1, 7));
    assertThrown!Exception(book.cellFormula(0, 0, 8));
    assertThrown!Exception(book.cellNumber(0, 0, 4));
    assertThrown!Exception(book.cellString(0, 0, 2));
    assert(book.cellType(0, 0, 2) == CellType.missing);
    assert(book.cellString(1, 1, 2) == "other");
    assertThrown!Exception(book.save()); // Saving to memory requires an in-memory workbook.
    assertThrown!Exception(book.sheetName(3));
    assertThrown!Exception(book.cellString(0, 1048576, 0));
    book.close();
    book.close();
    assertThrown!Exception(book.sheetCount());

    auto bytes = cast(ubyte[])read(args[1]);
    auto memoryBook = new Workbook(bytes);
    bytes[] = 0; // The bridge retains its own archive data.
    assert(memoryBook.sheetCount() == 3);
    assert(memoryBook.cellString(0, 0, 0) == "Привет 😀 & text");
    memoryBook.renameSheet(1, "Второй лист");
    memoryBook.setText(0, 0, 10, "replaced");
    assert(!memoryBook.cellHasFormula(0, 0, 10));
    memoryBook.setText(2, 2, 0, "Русский 😀 _x0041_ _x005F_x0041_ \x01\0\r\n & < >");
    memoryBook.setNumber(2, 2, 1, 42.25);
    memoryBook.setBoolean(2, 2, 2, true);
    memoryBook.setText(2, 2, 3, "");
    memoryBook.setText(2, 2, 4, "_x00G0_ _X0041_");
    memoryBook.setText(2, 2, 5, "\uFFFE\uFFFF");
    memoryBook.setPoiText(2, 2, 6, "_x0041_ _x005F_x0041_");
    assertThrown!Exception(memoryBook.setNumber(0, 0, 0, double.nan));
    assertThrown!Exception(memoryBook.setText(0, 1048576, 0, "invalid"));
    assertThrown!Exception(memoryBook.setText(0, 0, 0, cast(string)[cast(ubyte)0xFF]));
    memoryBook.setColumnHidden(0, 1, true);
    memoryBook.setColumnHidden(0, 3, true);
    assertThrown!Exception(memoryBook.setColumnHidden(0, 16384, true));
    assertThrown!Exception(memoryBook.renameSheet(0, "invalid\0name"));
    auto saved = memoryBook.save();
    auto reopened = new Workbook(saved);
    assert(reopened.sheetCount() == 3 && reopened.cellNumber(0, 0, 6) == 84);
    assert(reopened.sheetName(1) == "Второй лист");
    assert(reopened.cellType(2, 2, 0) == CellType.text);
    assert(reopened.cellNumber(2, 2, 1) == 42.25);
    assert(reopened.cellType(2, 2, 2) == CellType.boolean);
    assert(reopened.cellXml(0, 0, 9).canFind("_x0041_"));
    reopened.copyCell(0, 0, 1, 3, 1);
    reopened.copyCell(0, 0, 9, 3, 9);
    reopened.copyCell(0, 0, 3, 3, 3);
    reopened.copyCell(0, 0, 6, 3, 6, true);
    reopened.copyCell(0, 0, 6, 4, 6);
    reopened.copyCell(0, 3, 1, 3, 1);
    assert(reopened.cellNumber(0, 3, 1) == 42);
    assert(reopened.cellXml(0, 3, 1).canFind(`s="0"`));
    assert(reopened.cellType(0, 3, 3) == CellType.blank);
    assert(reopened.cellFormula(0, 3, 6) == "B1*2" && !reopened.cellXml(0, 3, 6).canFind("<v"));
    assert(reopened.cellFormula(0, 4, 6) == "B1*2" && reopened.cellNumber(0, 4, 6) == 84);
    assert(reopened.cellXml(0, 3, 9).canFind("First") && reopened.cellXml(0, 3, 9).canFind("_x0041_"));
    reopened.setNumber(2, 4, 0, 11); reopened.setNumber(2, 4, 1, 22);
    reopened.mergeCells(2, 4, 0, 4, 1);
    assert(reopened.cellNumber(2, 4, 1) == 22 && reopened.sheetXml(2).canFind("A5:B5"));
    assertThrown!Exception(reopened.mergeCells(2, 4, 1, 4, 0));
    assertThrown!Exception(reopened.mergeCells(2, 4, 0, 4, 0));
    assertThrown!Exception(reopened.copyCell(0, 0, 2, 3, 2));
    assertThrown!Exception(reopened.copyCell(0, 0, 1, 1048576, 0));
    reopened.removeCell(0, 3, 1);
    reopened.removeCell(0, 3, 9);
    reopened.removeCell(0, 3, 3);
    reopened.removeCell(0, 3, 3); // Repeated deletion is harmless.
    reopened.removeCell(0, 9, 9); // A missing row remains absent.
    assert(reopened.rowExists(0, 3) && reopened.cellType(0, 3, 1) == CellType.missing);
    assert(!reopened.rowExists(0, 9));
    assertThrown!Exception(reopened.removeCell(0, 3, 6));
    assertThrown!Exception(reopened.removeCell(0, 1048576, 0));
    auto copiedBytes = reopened.save();
    write(args[6], copiedBytes);
    auto copied = new Workbook(copiedBytes);
    assert(copied.rowExists(0, 3) && copied.cellType(0, 3, 1) == CellType.missing && copied.cellType(0, 3, 9) == CellType.missing);
    assert(copied.cellFormula(0, 3, 6) == "B1*2");
    assert(copied.cellNumber(2, 4, 1) == 22 && copied.sheetXml(2).canFind("A5:B5"));
    copied.close();
    reopened.close();
    memoryBook.setColumnHidden(0, 3, false);
    auto savedAgain = memoryBook.save();
    auto reopenedAgain = new Workbook(savedAgain);
    assert(reopenedAgain.sheetName(1) == "Второй лист");
    reopenedAgain.close();
    write(args[3], savedAgain);
    write(args[2], saved);
    memoryBook.close();
    auto styled = new Workbook(cast(ubyte[])read(args[4]));
    styled.setColumnHidden(0, 1, true);
    styled.setColumnHidden(0, 3, true);
    write(args[5], styled.save());
    styled.close();
    assertThrown!Exception(new Workbook(cast(ubyte[])[]));
    assertThrown!Exception(new Workbook(cast(ubyte[])[1, 2, 3]));
}
