import org.zenframework.z8.lang.encoding;
public class EnumInstanceOf {
    private static int calls;
    private static ProbeEnum next() { calls += 1; return ProbeEnum.One; }
    private static int missingInt() { calls += 1; return null; }
    public static int run() {
        ProbeEnum value = ProbeEnum.One;
        if (!(value instanceof ProbeEnum)) return 1;
        value = null;
        if (value instanceof ProbeEnum) return 2;
        if (null instanceof ProbeEnum) return 3;
        if (ProbeEnum.One instanceof EnumInstanceOf) return 4;
        EnumInstanceOf object;
        if (object instanceof ProbeEnum) return 5;
        ProbeOther other = ProbeOther.One;
        if (other instanceof ProbeEnum) return 6;
        if (!(next() instanceof ProbeEnum) || calls != 1) return 7;
        ProbeA first;
        if (first instanceof ProbeB) return 8;
        if (ProbeEnum.One instanceof ProbeA) return 9;
        if ((1 instanceof ProbeA) || (object instanceof int)) return 10;
        if ((next() instanceof int) || calls != 2) return 11;
        if ((missingInt() instanceof bool) || calls != 3) return 12;
        if (1 instanceof bool) return 13;
        if (1 instanceof exception) return 14;
        encoding charset = encoding.UTF8;
        if (!(charset instanceof encoding)) return 15;
        charset = null;
        if (charset instanceof encoding) return 16;
        if (encoding.UTF8 instanceof primary) return 17;
        if (1 instanceof encoding) return 18;
        return 221;
    }
}
