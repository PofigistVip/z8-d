[native "example.GenericNative"]
public class GenericNative {
    public GenericNative partner;
    public static NativeNumber current;
    public int get();
    public GenericNative echo(GenericNative value);
    public GenericNative invalid();
    public static int inspect(GenericNative value);
    public static GenericNative make();
    public static GenericNative makeInvalid();
    public GenericNative[] extend(GenericNative[] values);
    public static GenericNative[] invalidArray();
    public static void clearArray(GenericNative[] values);
    public void clear();
}
