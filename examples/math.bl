public class Math {
    public static int add(int a, int b) {
        return a + b;
    }

    public static bool positive(int value) {
        return value > 0;
    }

    public static int calculate(int value) {
        int result = add(value, 2);
        if (positive(result))
            result = result * 3;
        return result;
    }

    public static int divide(int a, int b) {
        return a / b;
    }

    public static int remainder(int a, int b) {
        return a % b;
    }

    public static bool nonzeroAndPositive(int a) {
        return a != 0 && divide(10, a) > 0;
    }

    public static int minimum() {
        return -9223372036854775808;
    }

    public static int sumOddUntilSeven(int limit) {
        int sum = 0;
        for (int i = 0; i < limit; i += 1) {
            if (i > 7) break;
            if (i % 2 == 0) continue;
            sum += i;
        }
        return sum;
    }

    public static int countDown(int value) {
        int count = 0;
        do {
            count += 1;
            value -= 1;
        } while (value > 0);
        return count;
    }

    public static int halve(int value) {
        int count = 0;
        while (value > 1) {
            value /= 2;
            count += 1;
        }
        return count;
    }

    public static int incrementInLoop(int value) {
        for (; value < 3; value += 1) noop();
        return value;
    }

    public static void noop() { return; }

    public static int divideInPlace(int a, int b) {
        a /= b;
        return a;
    }

    public static bool defaultValues() {
        int count;
        bool flag;
        return count == 0 && !flag;
    }

    public static string greeting(string name) {
        string message;
        message += "Hello, ";
        return message + name + "!\n";
    }

    public static bool emptyString() {
        string value;
        return value == "";
    }

    public static bool compareStrings(string a, string b) {
        return a < b;
    }

    public static string unicodeLiteral() {
        return "Ж😀";
    }

    public static int unicodeLength() {
        return unicodeLiteral().length();
    }

    public static bool stringIsEmpty(string value) {
        return value.isEmpty();
    }

    public static string escapedLiteral() {
        return "A\t\"\\\'Z";
    }

    public static int nestedLoops() {
        int sum = 0;
        for (int i = 0; i < 3; i += 1) {
            for (int j = 0; j < 3; j += 1) {
                if (j == 1) break;
                sum += 1;
            }
        }
        return sum;
    }

    public static int sum(int[] values) {
        int result;
        for (int i; i < values.size(); i += 1)
            result += values[i];
        return result;
    }

    public static int[] makeValues() {
        return {2, 4, 6,};
    }

    public static int updateArray() {
        int[] values = {2, 4};
        int[] alias = values;
        alias[0] += 3;
        alias.add(7);
        alias.set(1, 10);
        return sum(values);
    }

    public static int literalArgument() {
        return sum({3, 5});
    }

    public static bool emptyArray() {
        int[] values;
        values.add(1);
        values.clear();
        values = {};
        return values.isEmpty();
    }

    public static bool mixedArrays() {
        bool[] flags = {true, false};
        string[] words = {"one", "two"};
        flags[1] = true;
        words[0] += "!";
        return flags.get(1) && words[0] == "one!";
    }

    public static int indexEvaluatedOnce() {
        int[] values = {8};
        values[values.add(0).size() - 2] /= 2;
        return values.size() * 10 + values[0];
    }

    public static int elementAt(int[] values, int index) {
        return values[index];
    }

    public static int sumWithForeach(int[] values) {
        int result;
        for (int value : values) {
            if (value < 0) continue;
            if (value > 10) break;
            result += value;
        }
        return result;
    }

    public static int choose(bool condition, int x) {
        return condition ? x + 1 : x == 0 ? 7 : 10 / x;
    }

    public static void modifyDuringIteration() {
        int[] values = {1, 2};
        for (int value : values) values.add(value);
    }

    public static int caughtMessageLength() {
        try {
            throw "bad😀";
        } catch (exception problem) {
            return problem.getMessage().length();
        }
    }

    public static int divisionOrFallback(int a, int b) {
        try {
            return a / b;
        } catch (exception problem) {
            return 77;
        }
    }

    public static int cleanupOnReturn(int[] values) {
        try {
            return 1;
        } finally {
            values.add(5);
        }
    }

    public static bool caughtEmptyMessage() {
        exception problem;
        try {
            throw problem;
        } catch (exception caught) {
            return caught.getMessage().isEmpty();
        }
    }

    public static decimal price(decimal cost, int quantity) {
        decimal total = cost * quantity;
        total += 0.10;
        return total;
    }

    public static bool decimalRules() {
        decimal one = 1.0;
        decimal other = 1.00;
        return one != other && one <= other && 1.20 + 0.03 == 1.23;
    }

    public static string decimalText() {
        decimal value = 12345678901234567890123456789012345678.91;
        return value.toString();
    }

    public static string decimalDivision() {
        decimal value = 1.0;
        value /= 3;
        return value.toString();
    }

    public static bool mixedDecimalComparison() {
        return 1 < 1.0 && !(1 <= 1.0) && 1 > 1.0 && !(1 >= 1.0);
    }

    public static bool stringOperations() {
        string value = "a😀b😀";
        return value.startsWith("😀", 1) && value.endsWith("😀")
            && value.indexOf("😀", 2) == 4 && value.lastIndexOf("😀") == 4
            && value.substring(1, 2) == "😀" && value.charAt(1).length() == 1
            && "a".compare("abc") == -2 && "b".compare("a") == 1;
    }

    public static bool primitiveText() {
        int value = -42;
        return value.abs() == 42 && value.signum() == -1
            && value.toString() == "-42" && true.toString() == "true";
    }

    public static bool parsePrimitives() {
        return int.parse("-8000000000000000", 16) == minimum()
            && int.parse("7FL", 16) == 127 && int.parse("+42") == 42
            && decimal.parse("1e2").toString() == "100"
            && decimal.parse("") == 0;
    }
}
