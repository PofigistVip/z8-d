import demo.util.Numbers;

public class Main {
    public static int run() {
        Counter first = new Counter;
        first.add(5);
        Counter second = Counter.makeCopy(first);
        second.add(1);
        Holder holder;
        holder.bump();
        Base base = new Derived;
        int[] numbers = {1, 2, 3};
        return Numbers.sum(numbers) + Twice.apply(4) + Counter.run() + second.value + holder.counter.value + base.getValue();
    }
}
