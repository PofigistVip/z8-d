public class EnumFields {
    private FieldMode member;
    private FieldMode initialized = FieldMode.One;
    private static FieldMode shared;
    private static FieldMode missing = null;
    private static FieldMode initial = FieldMode.One;
    private static FieldMode[] history;

    public static int run() {
        EnumFields first;
        EnumFields second;
        if (first.member != null || shared != null || missing != null) return 1;
        if (!history.isEmpty()) return 5;
        history.add(FieldMode.Two);
        if (history.first() != FieldMode.Two) return 6;
        if (first.initialized != FieldMode.One || initial != FieldMode.One) return 2;
        first.member = FieldMode.Two;
        shared = first.member;
        if (second.member != null || shared != FieldMode.Two) return 3;
        first.member = null;
        if (first.member != null || shared != FieldMode.Two) return 4;
        return 223;
    }
}
