import demo.Counter;
import demo.Base;

public class NullableObjectField extends Base {
    private Counter item = null;
    public static int run() {
        NullableObjectField instance = new NullableObjectField;
        Base base = instance;
        if (!(base instanceof NullableObjectField)) return 2;
        try { int ignored = base.getValue(); return 3; } catch (exception expectedBase) { }
        if (base.getValue() != 2) return 4;
        instance = new NullableObjectField;
        try {
            Counter value = instance.item;
            return 1;
        } catch (exception expected) { }
        if (instance.item != null) return 5;
        return 163;
    }
}
