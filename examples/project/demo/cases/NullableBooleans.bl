public class NullableBooleans {
    private static bool field = null;
    private static int effects;
    private static bool pass(bool value) { return value; }
    private static bool missing() { return null; }
    private static bool effect() { effects += 1; return true; }
    public static int run() {
        bool literalBranch = false ? true : null;
        if (literalBranch != null || !(true ? true : null)) return 13;
        bool value = null;
        if (value != null || field != null || pass(value) != null) return 1;
        if (!(bool)(!false)) return 14;
        bool casted = (bool)value;
        bool chosen = true ? value : false;
        if (casted != null || chosen != null || (value ?: missing()) != null) return 2;
        bool[] empty;
        value = empty.first();
        if (value != null || (value ?: true) != true) return 3;
        try { bool ignored = value == effect(); return 4; } catch (exception expected) { if (effects != 1) return 5; }
        try { if (value && effect()) return 6; return 7; } catch (exception expectedCondition) { if (effects != 1) return 8; }
        value = false;
        if (value && effect()) return 9;
        if (effects != 1 || value == null || value != false) return 10;
        value = true;
        if (!value || !(value || effect()) || effects != 1) return 11;
        if (true == null || (true != missing())) return 12;
        return 149;
    }
}
