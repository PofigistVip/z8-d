public class FileValues {
    public static int run() {
        file value = "folder/report.TXT";
        if (value.name != "report.TXT" || value.path != "folder/report.TXT") return 1;
        if (value.baseName() != "report" || value.extension() != "txt" || value.fileName() != "report.TXT") return 2;
        if (file.name("a/b/c.TXT") != "c.TXT" || file.baseName("a/b/c.TXT") != "c" || file.extension("a/b/c.TXT") != "TXT") return 3;
        file alias = value;
        value = "other/new.dat";
        if (alias.path != "other/new.dat" || alias.name != "new.dat") return 4;
        file another = "other/different.txt";
        if (value == another || value != alias || value.hashCode() != guid.Null.hashCode()) return 5;
        file[] files = {value};
        if (!files.contains(another)) return 6;
        another.id = guid.create(1);
        if (files.contains(another)) return 7;
        file[] parsed = file.parse("[{\"path\":\"docs/a.txt\",\"name\":\"a.txt\",\"size\":42,\"id\":\"00000000-0000-0000-0000-000000000001\",\"author\":\"me\",\"details\":{\"kind\":\"text\"}}]");
        if (parsed.size() != 1 || parsed.first().path != "docs/a.txt" || parsed.first().size != 42) return 8;
        if (parsed.first().id != guid.create(1) || parsed.first().author != "me" || parsed.first().details.get("kind") != "text") return 9;
        file[] roundtrip = file.parse(file.toJson(parsed));
        if (roundtrip.first().name != "a.txt" || roundtrip.first().id != guid.create(1) || roundtrip.first().details.get("kind") != "text") return 10;
        if (file.parse("[]").size() != 0) return 11;
        try { file.parse("[{}]"); return 12; } catch (exception ignored) {}
        file[] alternate = file.parse("[{\"file\":\"other.txt\",\"path\":\"ignored.txt\",\"size\":0}]");
        if (alternate.first().path != "other.txt") return 13;
        return 211;
    }
}
