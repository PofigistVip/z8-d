public class FinalDeclarations {
    public final int field = 1;
    public static final int shared = 2;

    public int calculate(final int argument) {
        argument = 3;
        final int local = 1;
        local = 2;
        final int[] values = {2, 3};
        int sum = 0;
        for (final int value : values) {
            value += 1;
            sum += value;
        }
        for (final int i = 0; i < 3; i += 1) {
            sum += i;
        }
        decimal[][] matrix;
        decimal[] decimals = {1.0, 2.0};
        matrix.add(decimals);
        for (final decimal[] row : matrix) {
            if (row.size() != 2) return 2;
            sum += row.size();
        }
        try {
            throw "problem";
        } catch (final exception error) {
            if (error.getMessage() != "problem") return 1;
            error = "replaced";
            if (error.getMessage() != "replaced") return 3;
        }
        field = 5;
        shared = 6;
        return argument + local + sum + field + shared;
    }

    public static int run() {
        FinalDeclarations sample;
        return sample.calculate(0);
    }
}
