import org.zenframework.z8.lang.encoding;
public class StringExtras {
    public static int run() {
        string text = "AbC";
        if (text.toLowerCase() != "abc" || text.toUpperCase() != "ABC") return 1;
        if ("straße".toUpperCase() != "STRASSE") return 2;
        if ("Hello".firstToLowerCase() != "hello" || "world".firstToUpperCase() != "World") return 3;
        if (text.compareNoCase("aBc") != 0 || "abc".compareNoCase("abd") >= 0) return 4;
        if (string.replicate("xy", 3) != "xyxyxy" || string.replicate("", -1) != "") return 5;
        string[] words = {"a", "", "b"};
        if (string.concat(words, "-") != "a--b") return 6;
        binary data = '104, 105';
        if (string.fromBinary(data) != "hi" || data.length() != 0) return 7;
        guid identifier = guid.create(1);
        if ("id=" + identifier != "id=00000000-0000-0000-0000-000000000001") return 8;
        date day = '29/02/2024';
        string formatted = day;
        if (formatted != "2024-02-29T00:00:00+03:00" || day + "!" != "2024-02-29T00:00:00+03:00!") return 9;
        geometry point = geometry.point(1, 2, 0);
        string encoded = point;
        if (encoded != point.toString()) return 10;
        if (!"ab".matches("a|ab") || "abc".matches("a|ab")) return 11;
        if ("ab-ab".replaceAll("(a)(b)", "$2$1") != "ba-ba") return 12;
        if ("ab-ab".replaceFirst("(a)(b)", "<$0>") != "<ab>-ab") return 13;
        if ("HELLO-A".replaceAll("(?<word>[A-Z]+)", "<${word}>") != "<HELLO>-<A>") return 36;
        if (!"AB".matches("(?<first>A)B")) return 37;
        if (!"Ab".matches("(?i)ab") || !"5".matches("\\d") || "١".matches("\\d") || "é".matches("\\w")) return 38;
        if (" ".matches("\\s") || !"5".matches("[\\d]")) return 39;
        string[] split = "a,,b,,".split(",");
        if (split.size() != 3 || split[1] != "" || split[2] != "b") return 14;
        string[] limited = "a,,b,,".split(",", 2);
        if (limited.size() != 2 || limited.last() != ",b,,") return 15;
        string[] kept = "a,,".split(",", -1);
        if (kept.size() != 3 || kept.last() != "") return 16;
        if ("".split(",").size() != 1 || "abc".split("").size() != 3) return 17;
        binary utf16 = '254, 255, 0, 65, 0, 66';
        if (string.fromBinary(utf16, encoding.UTF16) != "AB") return 18;
        binary cp866 = '143, 224, 168, 162, 165, 226';
        if (string.fromBinary(cp866, encoding.Cp866) != "Привет") return 19;
        binary malformed = '192, 128';
        if (string.fromBinary(malformed) != "��") return 20;
        binary loneSurrogate = "😀".charAt(0);
        if (string.fromBinary(loneSurrogate) != "?") return 21;
        primary[] arguments = {"world", 1234567, decimal.parse("1234.56789"), true};
        if ("Hello {0}: {1} {2} {3}".format(arguments) != "Hello world: 1 234 567 1 234,568 true") return 22;
        if ("'{0}' ''{0}'' {5}".format(arguments) != "{0} 'world' {5}") return 23;
        primary[] rounded = {decimal.parse("-0.0005"), decimal.parse("0.0005"), decimal.parse("-0.0006")};
        if ("{0};{1};{2}".format(rounded) != "-0;0;-0,001") return 25;
        if ("{2,number,integer}|{2,number,percent}|{2,number,currency}|{2,number,#,##0.00}".format(arguments) != "1 235|123 457%|1 234,57 руб.|1 234,57") return 40;
        string subject = "aBcDe";
        string alias = subject;
        if (subject.next()) return 26;
        subject.setupMatcher("([a-z])([A-Z])");
        string distinct = "aBcDe";
        if (distinct.next()) return 31;
        if (!alias.next() || subject.getGroup(0) != "aB" || alias.getGroup(1) != "a" || alias.getGroup(2) != "B") return 27;
        if (!subject.next() || subject.getGroup(0) != "cD" || alias.next()) return 28;
        try { string invalid = subject.getGroup(0); return 29; } catch (exception expected) {}
        subject.setupMatcher(null);
        if (subject.next()) return 30;
        string empty = "";
        empty.setupMatcher("(a)?()");
        if (!empty.next() || empty.getGroup(1) != null || empty.getGroup(2) == null || empty.getGroup(2) != "") return 32;
        string otherEmpty = "";
        if (otherEmpty.next()) return 33;
        string original = "abc";
        original.setupMatcher("a");
        string independent = original.substring(0);
        if (independent.next() || !original.next()) return 34;
        string rendered = original.toString();
        if (rendered.next()) return 35;
        primary[] missing = {null};
        try { string unused = "unused".format(missing); return 24; } catch (exception expected) {}
        return 227;
    }
}
