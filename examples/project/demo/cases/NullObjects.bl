        if (item != null || null != item || !absent(null)) return 1;
        Counter[] values = null;
        if (values != null) return 2;
        Counter[] entries = {null};
        if (entries[0] != null) return 17;
        string[string] map = null;
        if (map != null) return 3;
        if (empty() != null) return 4;
        item = true ? new Counter : null;
        if (item == null || item.value != 3) return 5;
        try {
            item = null;
            item.add(effect());
            return 6;
        } catch (exception expected) {
            if (effects != 0) return 9;
            try {
                values.size();
                return 7;
            } catch (exception expectedArray) {
                try {
                    map.containsKey("a");
                    return 8;
                } catch (exception expectedMap) {
                    int[] missing = null;
                    int[] present;
