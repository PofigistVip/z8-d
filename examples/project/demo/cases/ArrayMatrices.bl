import org.zenframework.z8.lang.encoding;
public class ArrayMatrices {
    private static int rows(FieldMode[][] input) { return input.size(); }
    public static int run() {
        int[][] numbers = {{1, 2}, {3}};
        bool[][] flags = {{true}, {false}};
        string[][] words = {{"one"}, {"two", "three"}};
        if (numbers.size() != 2 || numbers[0][1] != 2) return 1;
        if (!flags[0][0] || flags[1][0]) return 2;
        if (words[1][1] != "three") return 3;
        int[] row = numbers[0];
        row.add(4);
        if (numbers[0].size() != 3) return 4;
        int total = 0;
        for (int[] item : numbers) total += item.size();
        if (total != 4) return 5;
        int[][] empty;
        if (empty.first() != null || empty.last() != null) return 6;
        empty.add(row);
        if (empty.first()[2] != 4 || empty[0].size() != 3) return 7;
        guid id = '00000000-0000-0000-0000-000000000001';
        binary bytes = '1, 2';
        datespan span = '1 02:03:04';
        date day = '29/02/2024';
        geometry point;
        file path = "matrix.txt";
        exception problem = "matrix";
        primary number = 42;
        guid[][] ids = {{id}};
        binary[][] payloads = {{bytes}};
        datespan[][] spans = {{span}};
        date[][] dates = {{day}};
        geometry[][] shapes = {{point}};
        file[][] paths = {{path}};
        exception[][] problems = {{problem}};
        primary[][] values = {{number}};
        if (ids[0][0].minor() != 1 || payloads[0][0].length() != 2) return 8;
        if (spans[0][0].days() != 1 || dates[0][0].year() != 2024) return 9;
        if (shapes[0].size() != 1 || paths[0][0].name != "matrix.txt") return 10;
        if (problems[0][0].getMessage() != "matrix" || values[0][0].toString() != "42") return 11;
        EnumFields object;
        EnumFields[][] objects = {{object}};
        FieldMode[][] modes = {{FieldMode.One, FieldMode.Two}};
        if (objects[0].size() != 1 || modes[0][1] != FieldMode.Two || rows(modes) != 1) return 12;
        if (!(objects[0][0] instanceof EnumFields)) return 13;
        int modeCount = 0;
        for (FieldMode[] modeRow : modes) modeCount += modeRow.size();
        if (modeCount != 2) return 14;
        encoding[][] encodings = {{encoding.UTF8, encoding.UTF16}};
        if (encodings[0][1] != encoding.UTF16) return 15;
        return 227;
    }
}
