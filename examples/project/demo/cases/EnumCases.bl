public class EnumCases {
    public Flavor color = Flavor.Green;
    private static bool isGreen(Flavor value) { return value == Flavor.Green; }
    public static Flavor pick(bool first) {
        return first ? Flavor.Red : Flavor.Blue;
    }
    public static int run() {
        Flavor value = pick(true);
        Flavor castValue = (Flavor)value;
        Flavor castSource = null;
        Flavor castNull = (Flavor)castSource;
        if (castValue != Flavor.Red || castNull != null) return 13;
        if (value != Flavor.Red || value == Flavor.Blue) return 1;
        value = pick(false);
        if (value != Flavor.Blue) return 2;
        Flavor empty = null;
        if (empty != null) return 3;
        EnumCases object = new EnumCases;
        if (!isGreen(object.color)) return 4;
        if (isGreen(null)) return 5;
        Flavor alternative = empty ?: Flavor.Green;
        if (alternative != object.color) return 6;
        Flavor[] values = {Flavor.Blue, Flavor.Red, Flavor.Blue, null};
        if (values.size() != 4 || !values.contains(Flavor.Blue)) return 7;
        Flavor[] unique = values.unique();
        if (unique.size() != 3 || unique[2] != null) return 8;
        if (unique.first() != Flavor.Blue || unique.last() != null) return 11;
        Flavor[] emptyValues;
        if (emptyValues.first() != null || emptyValues.last() != null) return 12;
        int count = 0;
        for (Flavor valueInArray : values) if (valueInArray == Flavor.Blue) count += 1;
        if (count != 2) return 9;
        Flavor[] other = {Flavor.Green};
        Flavor[] combined = unique + other;
        if (combined.size() != 4 || combined[3] != Flavor.Green) return 10;
        EnumCommas commaValue = EnumCommas.First;
        if (commaValue == EnumCommas.Second) return 13;
        return 127;
    }
}
