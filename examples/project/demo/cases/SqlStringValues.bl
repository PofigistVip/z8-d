import org.zenframework.z8.lang.sql.sql_string;
import org.zenframework.z8.lang.sql.sql_bool;
import org.zenframework.z8.lang.sql.sql_int;
import org.zenframework.z8.lang.sql.sql_decimal;
import org.zenframework.z8.lang.sql.sql_guid;
import org.zenframework.z8.lang.sql.sql_date;
import org.zenframework.z8.lang.sql.sql_datespan;
import org.zenframework.z8.lang.sql.sql_binary;
import org.zenframework.z8.lang.sql.sql_geometry;
public class SqlStringValues {
    public static sql_string literal() { return "O'Reilly 😀"; }
    public static sql_string concatenation() { sql_string value = "alpha"; return (value + " β").toUpper(); }
    public static sql_string convertedLeft() { sql_string value = "tail"; return "head" + value; }
    public static sql_string lower() { sql_string value = " ABC "; return value.toLower(); }
    public static sql_string trimmed() { sql_string value = " ABC "; return value.trimAll(); }
    public static sql_string choice() { sql_bool condition = true; return condition.IIF("yes", "no"); }
    public static sql_string replace() { sql_string value = "ababa"; return value.replace("a", "x"); }
    public static sql_string replaceAll() { sql_string value = "ababa"; return value.replaceAll("a", "x", "g"); }
    public static sql_string substring() { sql_string value = "abcdef"; return value.substring(1, 3); }
    public static sql_string remainder() { sql_string value = "abcdef"; return value.substring(1, null); }
    public static sql_string reverse() { sql_string value = "abc"; return value.reverse(); }
    public static sql_string padLeft() { sql_string value = "abc"; return value.padLeft(5); }
    public static sql_string padRight() { sql_string value = "abc"; return value.padRight(5, "_"); }
    public static sql_bool like() { sql_string value = "a%b"; return value.like("a!%b", "!"); }
    public static sql_bool regLike() { sql_string value = "abc"; return value.regLike("a.*"); }
    public static sql_int findIndex() { sql_string value = "abcabc"; return value.indexOf("bc"); }
    public static sql_int indexFrom() { sql_string value = "abcabc"; return value.indexOf("bc", 2); }
    public static sql_int patternIndex() { sql_string value = "abcabc"; return value.patIndexOf("b%"); }
    public static sql_bool contains() { sql_string value = "abcabc"; return value.contains("bc"); }
    public static sql_bool containsFrom() { sql_string value = "abcabc"; return value.contains("bc", 2); }
    public static sql_bool empty() { sql_string value = "abc"; return value.isEmpty(); }
    public static sql_int length() { sql_string value = "abc"; return value.length(); }
    public static sql_bool compare() { sql_string value = "alpha"; return value >= "beta"; }
    public static sql_int integer() { sql_string value = "123"; return value.toInt(); }
    public static sql_decimal number() { sql_string value = "12.5"; return value.toDecimal(); }
    public static sql_bool integerTest() { sql_string value = "123"; return value.isInt(); }
    public static sql_bool numberTest() { sql_string value = "12.5"; return value.isNumeric(); }
    public static sql_string quoted() { sql_string value = "value"; return value.quote(); }
    public static sql_string jsonName() { sql_string value = "json"; return value.json("a"); }
    public static sql_string jsonIndex() { sql_string value = "json"; return value.json(1); }
    public static sql_string identity() { sql_string value = "abc"; return value.toString(); }
    public static sql_string booleanText() { sql_bool value = true; return value.toString(); }
    public static sql_string integerText() { sql_int value = 42; return value.toString(); }
    public static sql_string decimalText() { sql_decimal value = 1.5; return value.toString(); }
    public static sql_string regexText() { sql_string value = "abc"; return value.regLike("a.*").toString(); }
    public static sql_string notIntegerText() { sql_int value = 42; return (~value).toString(); }
    public static sql_string choiceRegexText() { sql_bool condition = true; sql_string value = "abc"; return condition.IIF(value.regLike("a.*"), false).toString(); }
    public static sql_guid sqlGuid() { guid value = '00112233-4455-6677-8899-AABBCCDDEEFF'; return value; }
    public static sql_guid guidChoice() { sql_bool condition = true; sql_guid value = sqlGuid(); return condition.IIF(value, value); }
    public static sql_bool guidEqual() { sql_guid value = sqlGuid(); return value == '00112233-4455-6677-8899-AABBCCDDEEFF'; }
    public static sql_string guidText() { sql_guid value = sqlGuid(); return value.toString(); }
    public static sql_date sqlDate() { date value = 0; return value; }
    public static sql_date dateChoice() { sql_bool condition = true; sql_date value = sqlDate(); return condition.IIF(value, value); }
    public static sql_date parsedDate() { sql_string value = "01.01.2020"; return value.toDate(); }
    public static sql_int dateTicks() { sql_date value = sqlDate(); return value.toInt(); }
    public static sql_string dateText() { sql_date value = sqlDate(); return value.toString(); }
    public static sql_int dateMinute() { sql_date value = sqlDate(); return value.minute(); }
    public static sql_int dateHour() { sql_date value = sqlDate(); return value.hour(); }
    public static sql_int dateDay() { sql_date value = sqlDate(); return value.day(); }
    public static sql_int dateMonth() { sql_date value = sqlDate(); return value.month(); }
    public static sql_int dateYear() { sql_date value = sqlDate(); return value.year(); }
    public static sql_date dateTruncDay() { date time = 100000000; sql_date value = time; return value.truncDay(); }
    public static sql_date dateTruncGroupedDay() { sql_date value = sqlDate(); return value.truncDay(); }
    public static sql_date dateTruncHour() { sql_date value = sqlDate(); return value.truncHour(); }
    public static sql_date dateTruncMinute() { sql_date value = sqlDate(); return value.truncMinute(); }
    public static sql_date dateTruncSecond() { sql_date value = sqlDate(); return value.truncSecond(); }
    public static sql_date dateAddDay() { sql_date value = sqlDate(); return value.addDay(2); }
    public static sql_date dateAddHour() { sql_date value = sqlDate(); return value.addHour(2); }
    public static sql_date dateAddMinute() { sql_date value = sqlDate(); return value.addMinute(2); }
    public static sql_date dateAddSecond() { sql_date value = sqlDate(); return value.addSecond(2); }
    public static sql_bool dateCompare() { sql_date value = sqlDate(); date other = 100000000; return value < other; }
    public static sql_datespan sqlSpan() { datespan value = '1 02:03:04'; return value; }
    public static sql_datespan spanChoice() { sql_bool condition = true; sql_datespan value = sqlSpan(); return condition.IIF(value, value); }
    public static sql_datespan spanSum() { sql_datespan value = sqlSpan(); return value + value; }
    public static sql_datespan spanDifference() { sql_datespan value = sqlSpan(); return value - value; }
    public static sql_datespan dateDifference() { sql_date value = sqlDate(); return value - value; }
    public static sql_date datePlusSpan() { sql_date value = sqlDate(); return value + sqlSpan(); }
    public static sql_date dateMinusSpan() { sql_date value = sqlDate(); return value - sqlSpan(); }
    public static sql_date spanPlusDate() { sql_datespan value = sqlSpan(); return value + sqlDate(); }
    public static sql_bool spanCompare() { sql_datespan value = sqlSpan(); return value >= value; }
    public static sql_string spanText() { sql_datespan value = sqlSpan(); return value.toString(); }
    public static sql_int spanDays() { sql_datespan value = sqlSpan(); return value.days(); }
    public static sql_int spanHours() { sql_datespan value = sqlSpan(); return value.hours(); }
    public static sql_int spanMinutes() { sql_datespan value = sqlSpan(); return value.minutes(); }
    public static sql_int spanSeconds() { sql_datespan value = sqlSpan(); return value.seconds(); }
    public static sql_int spanTotalHours() { sql_datespan value = sqlSpan(); return value.totalHours(); }
    public static sql_int spanTotalMinutes() { sql_datespan value = sqlSpan(); return value.totalMinutes(); }
    public static sql_int spanTotalSeconds() { sql_datespan value = sqlSpan(); return value.totalSeconds(); }
    public static sql_datespan spanTruncHour() { sql_datespan value = sqlSpan(); return value.truncHour(); }
    public static sql_datespan spanTruncMinute() { sql_datespan value = sqlSpan(); return value.truncMinute(); }
    public static sql_datespan spanTruncSecond() { sql_datespan value = sqlSpan(); return value.truncSecond(); }
    public static sql_datespan spanAddDay() { sql_datespan value = sqlSpan(); return value.addDay(2); }
    public static sql_datespan spanAddHour() { sql_datespan value = sqlSpan(); return value.addHour(2); }
    public static sql_datespan spanAddMinute() { sql_datespan value = sqlSpan(); return value.addMinute(2); }
    public static sql_datespan spanAddSecond() { sql_datespan value = sqlSpan(); return value.addSecond(2); }
    public static sql_binary sqlBinary() { sql_binary value; return value; }
    public static sql_string binaryText() { sql_binary value = sqlBinary(); return value.toString(); }
    public static sql_geometry sqlGeometry() { geometry value = geometry.point(1.5, 2.5, 4326); return value; }
    public static sql_geometry geometryPoint() { return sql_geometry.point(1.5, 2.5, 4326); }
    public static sql_geometry geometryChoice() { sql_bool condition = true; sql_geometry value = sqlGeometry(); return condition.IIF(value, value); }
    public static sql_bool geometryEqual() { sql_geometry value = sqlGeometry(); return value == value; }
    public static sql_bool geometryIntersects() { sql_geometry value = sqlGeometry(); return value && value; }
    public static sql_string geometryText() { sql_geometry value = sqlGeometry(); return value.toString(); }
    public static sql_geometry emptyGeometry() { sql_geometry value; return value; }
    public static sql_string emptyGeometryText() { sql_geometry value; return value.toString(); }
    public static sql_bool emptyGeometryIntersects() { sql_geometry value; return value.intersects(value); }
    public static sql_geometry geometryChain() { sql_geometry value = sqlGeometry(); return value.centroid().buffer(1.5).element(2); }
    public static int run() {
        sql_string value = concatenation();
        if (value == null) return 1;
        string missing = null;
        try { sql_string invalid = missing; return 2; }
        catch (exception error) {}
        sql_string selected = choice();
        sql_bool relation = compare();
        return 241;
    }
}
