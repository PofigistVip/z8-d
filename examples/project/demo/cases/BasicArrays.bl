public class BasicArrays {
    public static int run() {
        guid[] identifiers = {'00000000-0000-0000-0000-000000000001'};
        if (!identifiers.contains(guid.create(1)) || identifiers.first().minor() != 1) return 1;
        binary data = '1, 2';
        binary[] payloads = {data};
        if (!payloads.contains(data) || payloads.first().length() != 2) return 2;
        datespan[] durations = {'1 02:03:04'};
        if (!durations.contains(datespan.parse("1 02:03:04")) || durations.last().days() != 1) return 3;
        date[] dates = {'29/02/2024 12:30:45'};
        if (!dates.contains(date.parse("2024-02-29T12:30:45+03:00"))) return 4;
        int count = 0;
        for (guid identifier : identifiers) { if (identifier.minor() == 1) count += 1; }
        if (count != 1) return 5;
        return 197;
    }
}
