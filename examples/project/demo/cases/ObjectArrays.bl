import demo.Counter;
import demo.Base;
import demo.Derived;

public class ObjectArrays {
    public static Counter[] make() {
        Counter[] result;
        Counter first = new Counter;
        first.add(2);
        result.add(first);
        Counter second = new Counter;
        second.add(4);
        result.add(second);
        return result;
    }
    public static int sum(Counter[] values) {
        int total = 0;
        for (Counter item : values) total += item.value;
        return total;
    }
    public static int run() {
        Counter[] values = make();
        values[0].add(1);
        if (values.size() != 2) return 1;
        Counter[] literals = {new Counter, new Counter};
        if (literals[0].value != 3) return 2;
        Counter[] extra;
        extra.addAll(literals);
        extra.set(0, values[0]);
        if (extra[0].value != 6 || extra.removeAt(1).value != 3) return 3;
        Counter[] joined = values + literals;
        Counter[] old = joined;
        joined += extra;
        if (joined.size() != 5 || old.size() != 4 || joined[0].value != 6) return 5;
        Counter[] missing = null;
        try {
            joined += missing;
            return 6;
        } catch (exception expected) {
            if (joined.size() != 5) return 7;
        }
        Counter[] repeated = {values[0], values[0], values[1]};
        if (!repeated.contains(values[0]) || repeated.indexOf(values[1]) != 2) return 8;
        Counter[] distinct = repeated.unique();
        if (distinct.size() != 2 || !distinct.isSubsetOf(repeated)) return 9;
        if (!repeated.remove(values[0]) || repeated.size() != 2) return 10;
        Counter[] removal = {values[1]};
        repeated.removeAll(removal);
        if (repeated.size() != 1 || repeated[0].value != 6) return 11;
        Counter[] nullable = {null, values[0], null};
        if (nullable.unique().size() != 2) return 12;
        try {
            int index = nullable.indexOf(values[0]);
            return 14;
        } catch (exception expectedNullElement) {
        }
        try {
            bool found = nullable.contains(values[0]);
            return 15;
        } catch (exception expectedNullContains) {
        }
        if (!nullable.remove(values[0]) || nullable.size() != 2) return 13;
        Counter[] same = {null, values[0]};
        try {
            same.removeAll(same);
            return 16;
        } catch (exception expectedPartialRemoval) {
            if (same.size() != 1 || same[0].value != 6) return 17;
        }
        Base[] inherited;
        inherited.add(new Derived);
        for (Base item : inherited) if (item.getValue() != 14) return 4;
        return sum(values);
    }
}
