public class BooleanMapIndex {
    public static int run() {
        int[bool] values;
        values[true] = 4;
        values[false] = 5;
        values[null] = null;
        if (values[true] != 4 || values[false] != 5 || !values.containsKey(null) || values[null] != null) return 1;
        return 157;
    }
}
