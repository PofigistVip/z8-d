import org.zenframework.z8.base.table.Table;
import org.zenframework.z8.base.table.system.ScheduledJobs;
import org.zenframework.z8.base.table.value.Link;
import org.zenframework.z8.base.table.value.TextField;
import org.zenframework.z8.base.table.value.DatetimeField;
import org.zenframework.z8.base.table.value.BoolField;
import org.zenframework.z8.base.table.value.FileField;
import org.zenframework.z8.base.table.value.IntField;

// ScheduledJobLogs is a Java-only framework table in the original distribution.
[name "SystemScheduledJobLogs"]
[native "org.zenframework.z8.server.base.table.system.ScheduledJobLogs"]
public class ScheduledJobLogs extends Table {
    public ScheduledJobs scheduledJobs;
    [name "Description"] public TextField description;
    [name "ScheduledJob"] public Link scheduledJob;
    [name "Start"] public DatetimeField start;
    [name "Finish"] public DatetimeField finish;
    [name "Errors"] public BoolField errors;
    [name "Files"] public FileField file;
    [name "File size"] public IntField fileSize;
}
