import org.zenframework.z8.base.table.Table;
import org.zenframework.z8.base.table.system.Jobs;
import org.zenframework.z8.base.table.system.Users;
import org.zenframework.z8.base.table.value.Link;
import org.zenframework.z8.base.table.value.TextField;
import org.zenframework.z8.base.table.value.StringField;
import org.zenframework.z8.base.table.value.DatetimeField;
import org.zenframework.z8.base.table.value.BoolField;

// ScheduledJobs is a Java-only framework table in the original distribution.
[name "SystemScheduledJobs"]
[native "org.zenframework.z8.server.base.table.system.ScheduledJobs"]
public class ScheduledJobs extends Table {
    public Jobs jobs;
    public Users users;
    [name "Description"] public TextField description;
    [name "Job"] public Link job;
    [name "User"] public Link user;
    [name "Cron"] public StringField cron;
    [name "LastStart"] public DatetimeField lastStart;
    [name "LastFinish"] public DatetimeField lastFinish;
    [name "NextStart"] public DatetimeField nextStart;
    [name "Active"] public BoolField active;
    [name "Log errors only"] public BoolField logErrorsOnly;
}
