import org.zenframework.z8.base.table.Table;
import org.zenframework.z8.base.table.value.StringField;

// Jobs is a Java-only framework table in the original Z8 distribution.
[name "SystemJobs"]
[native "org.zenframework.z8.server.base.table.system.Jobs"]
public class Jobs extends Table {
    [name "Name"] public StringField name;
    [name "Class"] public StringField classId;
}
