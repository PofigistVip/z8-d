import org.zenframework.z8.base.form.Listbox;
import org.zenframework.z8.base.table.system.Fields;
import org.zenframework.z8.base.table.system.Tables;
import org.zenframework.z8.server.base.table.system.view.TablesReport;

[request] [displayName "$Tables.title$"]
public class TablesView extends Tables {
    Fields fields;
    Listbox fieldsListbox;
    TablesReport download;

    readOnly = true;
    colCount = 6;
    fields.readOnly = true;
    fields.columns = {fields.name, fields.type, fields.displayName, fields.description};
    fieldsListbox.query = fields;
    fieldsListbox.link = fields.table;
    fieldsListbox.sortFields = {fields.position};
    fieldsListbox.colSpan = 6;
    fieldsListbox.flex = 1;
    classId.colSpan = 2;
    name.colSpan = 2;
    name.width = 100;
    displayName.colSpan = 2;
    displayName.width = 200;
    description.colSpan = 6;
    description.height = 2;
    controls = {classId, name, displayName, description, fieldsListbox};
    names = {displayName, name};
    sortFields = {name};
    reports = {download};
}
